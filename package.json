{
  "name": "leaonline-backend",
  "private": true,
  "scripts": {
    "start": "meteor run",
    "test:once": "meteor test --once --driver-package meteortesting:mocha",
    "test:app": "TEST_WATCH=1 meteor test --full-app --driver-package meteortesting:mocha",
    "lint:code": "npx @biomejs/biome lint ./",
    "lint:code-fix": "npx @biomejs/biome lint --write ./",
    "format:code": "npx @biomejs/biome format ./",
    "format:code-fix": "npx @biomejs/biome format --write ./",
    "lint:style": "stylelint \"**/*.scss\"",
    "lint:style-fix": "stylelint --fix \"**/*.scss\"",
    "build:notes-tree": "markdown-notes-tree && npm run lint:markdown-fix",
    "visualize": "meteor --production --extra-packages bundle-visualizer"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.6",
    "@fortawesome/fontawesome-free": "^5.15.4",
    "@popperjs/core": "^2.11.8",
    "@shopify/draggable": "^1.2.1",
    "@swc/helpers": "^0.5.18",
    "bootstrap": "^5.3.8",
    "dely": "^1.0.2",
    "easy-speech": "^2.4.0",
    "fast-shuffle": "^6.1.1",
    "file-saver": "^2.0.5",
    "highlight.js": "^11.11.1",
    "jquery": "^4.0.0",
    "lozad": "^1.16.0",
    "marked": "^17.0.1",
    "meteor-node-stubs": "^1.2.25",
    "sortablejs": "^1.15.6",
    "select2": "^4.0.6",
    "simpl-schema": "^1.12.0"
  },
  "meteor": {
    "mainModule": {
      "client": "client/main.js",
      "server": "server/main.js"
    },
    "testModule": "tests/main.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "babel-plugin-istanbul": "^7.0.1",
    "chai": "^6.2.2",
    "puppeteer": "^24.37.2",
    "simpl-schema": "^1.13.1",
    "sinon": "^21.0.1"
  },
  "babel": {
    "env": {
      "COVERAGE": {
        "plugins": [
          "istanbul"
        ]
      }
    }
  }
}
